# Public URL. For Docker Compose with Caddy use your DNS name without a scheme in APP_DOMAIN.
APP_DOMAIN=app.example.ru
APP_URL=https://app.example.ru
NEXT_PUBLIC_APP_URL=https://app.example.ru
NODE_ENV=production
PORT=3000

# Local Docker PostgreSQL/PostGIS credentials. Use a URL-safe random password.
POSTGRES_DB=microgigs
POSTGRES_USER=microgigs
POSTGRES_PASSWORD=replace-with-a-long-url-safe-password
POSTGRES_PORT=5432
DATABASE_URL=postgresql://microgigs:replace-with-a-long-url-safe-password@db:5432/microgigs?schema=public
DIRECT_DATABASE_URL=postgresql://microgigs:replace-with-a-long-url-safe-password@db:5432/microgigs?schema=public

# Session and OTP secrets: independent random values of at least 32 bytes.
# Generate each one with: openssl rand -base64 48
AUTH_SECRET=replace-with-a-random-secret-at-least-32-characters
# Dedicated token for /api/internal/jobs. Do not reuse AUTH_SECRET.
INTERNAL_JOB_SECRET=replace-with-another-random-secret-at-least-32-characters
ACCESS_TOKEN_TTL_SECONDS=900
REFRESH_TOKEN_TTL_SECONDS=2592000
OTP_PEPPER=replace-with-a-different-random-secret-at-least-32-characters
OTP_TTL_SECONDS=300
SMS_PROVIDER=disabled
# Для входа по телефону: SMS_PROVIDER=sms_ru и секретный api_id из кабинета SMS.ru.
SMS_RU_API_ID=

# Yandex Developer Dashboard: separate keys for JS API v3 and HTTP Geocoder.
# Restrict the browser key by production domain/Referer.
NEXT_PUBLIC_YANDEX_MAPS_API_KEY=replace-with-yandex-js-api-v3-key
# Keep this key server-side; restrict by server IP where the hosting provider offers a stable IP.
YANDEX_GEOCODER_API_KEY=replace-with-yandex-http-geocoder-key

# Telegram BotFather / Mini App.
# Real Telegram authentication requires an HTTPS URL linked to the bot in BotFather;
# localhost placeholders only keep the application bootable and cannot authenticate users.
NEXT_PUBLIC_TELEGRAM_BOT_USERNAME=your_bot_without_at
TELEGRAM_BOT_TOKEN=123456789:replace-with-real-bot-token
# Generate with: openssl rand -hex 32
TELEGRAM_WEBHOOK_SECRET=replace-with-an-independent-random-webhook-secret

# Local/public-test account switcher. Disable for a real production launch.
ADMIN_TELEGRAM_ID=replace-with-your-telegram-numeric-id
ENABLE_TEST_AUTH=false
TEST_AUTH_ACCESS_CODE=replace-with-a-random-code-at-least-8-characters

# Optional Telegram OIDC/Web Login. Uncomment only after configuring Allowed URLs in BotFather.
# TELEGRAM_OIDC_CLIENT_ID=123456789
# TELEGRAM_OIDC_CLIENT_SECRET=replace-with-client-secret
# TELEGRAM_OIDC_REDIRECT_URI=https://app.example.ru/api/auth/telegram/callback

# Optional ЮKassa test shop. Never expose these values through NEXT_PUBLIC_*.
# YOOKASSA_SHOP_ID=replace-with-test-shop-id
# YOOKASSA_SECRET_KEY=test_replace-with-yookassa-secret-key
# YOOKASSA_WEBHOOK_TOKEN=replace-with-an-independent-random-value-at-least-32-characters

# Optional Redis for distributed Socket.io/rate limiting when the app scales beyond one instance.
# REDIS_URL=redis://redis:6379

# Optional private S3-compatible media storage (Yandex Object Storage, Selectel, MinIO).
# Leave all values empty to keep the backward-compatible database data-URL fallback for local MVP use.
# S3_ENDPOINT=https://storage.yandexcloud.net
# S3_REGION=ru-central1
# S3_BUCKET=ryadom-private-media
# S3_ACCESS_KEY_ID=replace-with-service-account-key-id
# S3_SECRET_ACCESS_KEY=replace-with-service-account-secret
# Use true for MinIO and providers that require path-style bucket URLs.
# S3_FORCE_PATH_STYLE=false
