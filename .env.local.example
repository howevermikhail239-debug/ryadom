# Application
NODE_ENV=development
NEXT_PUBLIC_APP_URL=http://localhost:3000
APP_URL=http://localhost:3000
AUTH_SECRET=replace-with-at-least-32-random-characters
ACCESS_TOKEN_TTL_SECONDS=900
REFRESH_TOKEN_TTL_SECONDS=2592000

# PostgreSQL/PostGIS. DATABASE_URL may point to PgBouncer; DIRECT_DATABASE_URL must not.
DATABASE_URL=postgresql://microgigs:change-me@localhost:5432/microgigs?schema=public
DIRECT_DATABASE_URL=postgresql://microgigs:change-me@localhost:5432/microgigs?schema=public

# Yandex Maps: browser key must be restricted by HTTP Referer.
NEXT_PUBLIC_YANDEX_MAPS_API_KEY=replace-with-yandex-js-api-key
# Keep HTTP Geocoder key server-only and restrict it by server IP where available.
YANDEX_GEOCODER_API_KEY=replace-with-yandex-geocoder-key

# Phone OTP
OTP_PEPPER=replace-with-an-independent-32-character-random-secret
OTP_TTL_SECONDS=300
SMS_PROVIDER=disabled
SMS_RU_API_ID=

# Telegram Login/OIDC and Bot API
NEXT_PUBLIC_TELEGRAM_BOT_USERNAME=your_bot
TELEGRAM_BOT_TOKEN=123456789:replace-with-real-bot-token
TELEGRAM_OIDC_CLIENT_ID=123456789
TELEGRAM_OIDC_CLIENT_SECRET=replace-with-telegram-client-secret
TELEGRAM_OIDC_REDIRECT_URI=http://localhost:3000/api/auth/telegram/callback

# Payments (server only)
YOOKASSA_SHOP_ID=replace-with-shop-id
YOOKASSA_SECRET_KEY=replace-with-secret-key
YOOKASSA_WEBHOOK_TOKEN=replace-with-at-least-32-random-characters

# Rate limiting, queues, Socket.io adapter
REDIS_URL=redis://localhost:6379
